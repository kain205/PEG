+    return (f"{fi},{tid},{max(0.0, x1):.2f},{max(0.0, y1):.2f},"
+            f"{max(1.0, x2 - x1):.2f},{max(1.0, y2 - y1):.2f},{cs},-1,-1,-1")
+
